# Copy to .env for root docker compose: cp .env.selfhost.example .env
JWT_SECRET=replace-with-openssl-rand-hex-32
VITE_API_URL=http://localhost:8000

# Optional. Coarse usage only: command or screen, package version, success or failure.
# Leave the key empty to send nothing. Do not put a real key in git.
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=
